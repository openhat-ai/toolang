use skill briceyan/pdf-processing

prompt summarize:
  params = style, audience?

  Summarize the request in a {{style}} style.
  Audience: {{audience}}

struct WorkspaceSummary:
  title: Text
  summary: Text

thunk summarize(in: Part[]) -> WorkspaceSummary:
  models = gpt-5
  skills = review

  Produce a concise workspace summary.
