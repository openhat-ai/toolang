#!/usr/bin/env toolang

##! Try prose runs and simple collection transformations locally.

struct Summary:
  title: Text
  summary: Text

struct BulletList:
  items: Text[]

agic slug(title) -> Text:
  Convert the provided title into a concise lowercase slug.
  Use hyphens between words and return only the slug text.

flow a:
  run: Say hello to the reader.

  Explain the purpose of a simple greeting.

  scatter 8 using:
    Suggest eight different greetings for this situation.
  gather using:
    Combine the greetings into a concise welcome message.

skill abc:
  description = Write a friendly greeting.

  Welcome the reader in one short sentence.

task heloo:
  Write a greeting for the reader.
