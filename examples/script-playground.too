#!/usr/bin/env toolang

# This file is designed for local script-run experiments.
# It keeps the capabilities minimal and focuses on different agic shapes.

struct Summary:
  title: Text
  summary: Text

struct BulletList:
  items: Text[]

# agic summarize(_: Part[]) -> Summary:
#   Produce a compact summary with a short title and a short summary paragraph.

# agic bullets(_: Part[]) -> BulletList:
#   Extract the main points into short bullet items.

# agic rewrite(_: Part[], tone?, audience?):
#   Rewrite the input in the requested tone.
#   Adjust depth and wording for the requested audience when it is provided.


agic slug(title) -> Text:
  Convert the provided title into a concise lowercase slug.
  Use hyphens between words and return only the slug text.

flow a:
    run: hello world

    hello world

    ## sdfsdf
    women

    scatter 8: sdfsdf
    gather:
        sdfsdf sdfsdf

skill abc:
    hello


task heloo:
    hello world
