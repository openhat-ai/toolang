#!/usr/bin/env toolang

# File request runtime example.
#
# Run:
# mkdir -p inbox
# toolang examples/file-inbox-indexer.too --inbox ./inbox
#
# Drop files into ./inbox. Each discovered file is sent to the `file` agic.
# The agic appends a short text summary to the roaming agent home file:
#
# examples/.toolang/agents/file-inbox-indexer/outbox/index.md

agic file(_: Part[]):
  tools = fs/*

  user:
    Process the current file request immediately. Do not ask for confirmation.
    Append each file with its short text summary to `outbox/index.md` in the agent home.
    After the file is written, reply with only: Indexed `<file name or path>`.
