#!/usr/bin/env toolang

# Manual check for simulating a short thread while allowing future memory
# retrieval. `recall = memory` still keeps stored thread history out of the
# model input, so the explicit message blocks below are the conversation replay.
#
#   toolang examples/invoke.simulated-history.memory.too followup "What did I ask you to remember?"

agic followup(_: Part[]):
  recall = memory

  context none
  instruct none

  user:
    Remember that the deployment window is Friday morning.

  assistant:
    I will use Friday morning as the deployment window.

  user:
    Answer using the simulated conversation above: {{_}}
