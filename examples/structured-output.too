# Extract meeting action items as structured output.

struct ActionItem:
  task: Text
  owner?: Text
  due?: Text

agic -> ActionItem[]:
  recall = none
  tools = none

  Extract the explicit action items from this text.

  Every item needs one concrete task. Include an owner or due date only when
  the text states it, and omit the field otherwise. Keep relative dates as
  written. Do not turn suggestions or finished work into commitments. Return
  an empty array when nothing was assigned.

  {{_}}
