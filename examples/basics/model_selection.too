#!/usr/bin/env toolang

# Select one model from an agic's authored allowlist.
# Requires the selected model to be configured and available.
# --model selects one identity; repeated flags are not a fallback list.
#
# Use Claude:
#   uv run too examples/basics/model_selection.too rewrite \
#     --model anthropic/claude-sonnet-4.5 -- "Rewrite this sentence."
#
# Use GPT-5:
#   uv run too examples/basics/model_selection.too rewrite \
#     --model openai/gpt-5 -- "Rewrite this sentence."
# Expected: a short rewrite for a technical audience.

agic rewrite(_: Part[]):
  models = openai/gpt-5, anthropic/claude-sonnet-4.5, google/gemini-3.1-pro-preview

  Rewrite the input for a technical audience.
  Keep the answer short and direct.
