#!/usr/bin/env toolang

# Manual check for simulating a short thread in one script run.
# `recall = none` keeps stored thread history out of the model input, so the
# explicit user/assistant/user blocks below are the only conversation history.
#
# Requires a configured model. From the repository root:
#   uv run too examples/basics/simulated_history_none.too followup \
#     -- "What is my name?"
# Expected: the answer mentions Ada.

agic followup(_: Part[]):
  recall = none
  context none

  user:
    My name is Ada.

  assistant:
    Nice to meet you, Ada.

  user:
    Answer using the simulated conversation above: {{_}}
