#!/usr/bin/env toolang

# Restrict one agic to a single model identity.
# Requires configured openai/gpt-5 and access to briceyan/review.
#
# Success:
#   uv run too examples/basics/fixed_model.too gpt_only \
#     --model openai/gpt-5 -- "Rewrite this sentence."
#
# With both models configured, this selection is outside the agic's allowlist:
#   uv run too examples/basics/fixed_model.too gpt_only \
#     --model anthropic/claude-sonnet-4.5 -- "Rewrite this sentence."

with skill briceyan/review

agic gpt_only(_: Part[]):
  models = openai/gpt-5

  Rewrite the input into one concise paragraph.
  Preserve the original meaning and improve clarity.
