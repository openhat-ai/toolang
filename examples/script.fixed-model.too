#!/usr/bin/env toolang

# Manual checks for one agic-level model choice.
#
# Success:
#   toolang examples/script.fixed-model.too gpt_only "Rewrite this sentence." --model openai/gpt-5@openrouter
#
# Expected failure because the agic only allows openai/gpt-5:
#   toolang examples/script.fixed-model.too gpt_only "Rewrite this sentence." --model anthropic/claude-sonnet-4.5@openrouter

with skill briceyan/review

agic gpt_only(_: Part[]):
  models = openai/gpt-5

  Rewrite the input into one concise paragraph.
  Preserve the original meaning and improve clarity.
